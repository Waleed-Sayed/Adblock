<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/bg"
    android:padding="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="rtl">
    <TextView
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="تخصيص الاختصار وأيقونة الإعدادات" />
    <EditText
        android:textSize="15sp"
        android:textColor="@color/text"
        android:textColorHint="@color/text_muted"
        android:id="@+id/etShortcutName"
        android:background="@drawable/bg_field"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginBottom="12dp"
        android:hint="اسم الاختصار (اتركه فارغاً لإخفاء النص)"
        android:inputType="text"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:importantForAutofill="no" />
    <TextView
        android:textSize="14sp"
        android:textColor="@color/text_muted"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="اختر أيقونة من إعدادات النظام الرسمية:" />
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSettingsIcons"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginBottom="16dp" />
    <Button
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/text"
        android:id="@+id/btnConfirmAddShortcut"
        android:background="@drawable/bg_primary_button"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="تثبيت الاختصار على الشاشة الرئيسية"
        android:textAllCaps="false" />
</LinearLayout>
