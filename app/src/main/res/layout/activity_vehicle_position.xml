<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/posRoot"
    android:background="@color/bg"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="10dp"
        android:paddingBottom="6dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="16dp">
        <TextView
            android:textSize="22sp"
            android:textColor="@color/text"
            android:id="@+id/btnBack"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="←" />
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/pos_title"
            android:layout_weight="1"
            android:layout_marginStart="6dp" />
        <TextView
            android:textSize="14sp"
            android:textColor="@color/accent"
            android:id="@+id/btnChangePin"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pos_change_pin" />
    </LinearLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/statusCard"
                android:background="@drawable/bg_status_stopped"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">
                <View
                    android:id="@+id/statusDot"
                    android:background="@drawable/dot_stopped"
                    android:layout_width="10dp"
                    android:layout_height="10dp" />
                <TextView
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/danger"
                    android:id="@+id/mockStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pos_status_idle"
                    android:layout_marginStart="8dp" />
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/text_muted"
                    android:ellipsize="end"
                    android:gravity="end"
                    android:id="@+id/mockDetails"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp" />
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/text_muted"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nav_mode_title" />
                <RadioGroup
                    android:orientation="horizontal"
                    android:id="@+id/rgNavMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp">
                    <RadioButton
                        android:textSize="15sp"
                        android:textColor="@color/text"
                        android:id="@+id/rbRealNavMode"
                        android:padding="4dp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/nav_mode_real"
                        android:layout_weight="1" />
                    <RadioButton
                        android:textSize="15sp"
                        android:textColor="@color/text"
                        android:id="@+id/rbFullMockMode"
                        android:padding="4dp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/nav_mode_full_mock"
                        android:layout_weight="1" />
                </RadioGroup>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp">
                    <TextView
                        android:textSize="14sp"
                        android:layout_marginTop="0dp"
                        android:layout_marginBottom="4dp"
                        android:text="@string/pos_lat"
                        style="@style/FieldLabel" />
                    <EditText
                        android:textSize="16sp"
                        android:textColor="@color/text"
                        android:textColorHint="@color/text_muted"
                        android:id="@+id/inputLat"
                        android:background="@drawable/bg_field"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="24.7136"
                        android:inputType="numberDecimal|numberSigned"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:importantForAutofill="no" />
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <TextView
                        android:textSize="14sp"
                        android:layout_marginTop="0dp"
                        android:layout_marginBottom="4dp"
                        android:text="@string/pos_lon"
                        style="@style/FieldLabel" />
                    <EditText
                        android:textSize="16sp"
                        android:textColor="@color/text"
                        android:textColorHint="@color/text_muted"
                        android:id="@+id/inputLon"
                        android:background="@drawable/bg_field"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="46.6753"
                        android:inputType="numberDecimal|numberSigned"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:importantForAutofill="no" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/text_muted"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/favorite_label" />
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/text"
                    android:id="@+id/favoriteName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/favorite_none" />
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">
                    <Button
                        android:textSize="14sp"
                        android:textColor="@color/warning"
                        android:id="@+id/btnSaveFavorite"
                        android:background="@drawable/bg_key"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:text="@string/save_favorite"
                        android:layout_weight="1"
                        android:textAllCaps="false"
                        android:layout_marginEnd="6dp" />
                    <Button
                        android:textSize="14sp"
                        android:textColor="@color/accent"
                        android:id="@+id/btnFavorites"
                        android:background="@drawable/bg_key"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:text="@string/favorites_list"
                        android:layout_weight="1"
                        android:textAllCaps="false" />
                </LinearLayout>
            </LinearLayout>
            <Button
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                android:id="@+id/btnPickTarget"
                android:background="@drawable/bg_key"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:text="@string/pick_target"
                android:textAllCaps="false" />
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">
                <Button
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary"
                    android:id="@+id/btnStart"
                    android:background="@drawable/bg_key"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:text="@string/pos_start"
                    android:layout_weight="1"
                    android:textAllCaps="false" />
                <Button
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/accent"
                    android:id="@+id/btnSwitch"
                    android:background="@drawable/bg_key"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:text="@string/pos_switch"
                    android:layout_weight="1"
                    android:textAllCaps="false"
                    android:layout_marginStart="6dp" />
                <Button
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/danger"
                    android:id="@+id/btnStop"
                    android:background="@drawable/bg_key"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:text="@string/pos_stop"
                    android:layout_weight="1"
                    android:textAllCaps="false"
                    android:layout_marginStart="6dp" />
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">
                <Button
                    android:textSize="13sp"
                    android:textColor="@color/accent"
                    android:id="@+id/btnCreateShortcut"
                    android:background="@drawable/bg_key"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:text="@string/create_shortcut"
                    android:layout_weight="1"
                    android:textAllCaps="false" />
                <Button
                    android:textSize="13sp"
                    android:textColor="@color/warning"
                    android:id="@+id/btnCreateSwitchShortcut"
                    android:background="@drawable/bg_key"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:text="@string/create_switch_shortcut"
                    android:layout_weight="1"
                    android:textAllCaps="false"
                    android:layout_marginStart="6dp" />
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">
                <Button
                    android:textSize="13sp"
                    android:textColor="@color/primary"
                    android:id="@+id/btnCreateResetShortcut"
                    android:background="@drawable/bg_key"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:text="@string/create_reset_shortcut"
                    android:layout_weight="1"
                    android:textAllCaps="false" />
                <Button
                    android:textSize="13sp"
                    android:textColor="@color/accent"
                    android:id="@+id/btnCreateSetShortcut"
                    android:background="@drawable/bg_key"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:text="@string/create_set_shortcut"
                    android:layout_weight="1"
                    android:textAllCaps="false"
                    android:layout_marginStart="6dp" />
            </LinearLayout>
            <Button
                android:textSize="13sp"
                android:textColor="@color/text_muted"
                android:id="@+id/btnDevOptions"
                android:background="?attr/selectableItemBackground"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="6dp"
                android:text="@string/pos_open_dev"
                android:textAllCaps="false" />
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">
                <TextView
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/accent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/shortcut_info_title" />
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/text_muted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/shortcut_info_body"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
