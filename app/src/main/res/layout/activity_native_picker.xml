<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/bg"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <org.osmdroid.views.MapView
        android:id="@+id/osmMap"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:id="@+id/osmSearchBar"
        android:background="@drawable/bg_search_bar"
        android:padding="6dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp">
        <EditText
            android:textSize="14sp"
            android:textColor="@color/text"
            android:textColorHint="@color/text_muted"
            android:id="@+id/osmSearchInput"
            android:background="@null"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:hint="@string/search_hint"
            android:singleLine="true"
            android:layout_weight="1"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:paddingStart="10dp"
            android:paddingEnd="10dp" />
        <Button
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#04140E"
            android:id="@+id/osmSearchBtn"
            android:background="@drawable/bg_primary_button"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="@string/search"
            android:textAllCaps="false"
            android:paddingStart="16dp"
            android:paddingEnd="16dp" />
    </LinearLayout>
    <ListView
        android:layout_gravity="top"
        android:id="@+id/osmResults"
        android:background="@drawable/bg_card"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="74dp"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp" />
    <Button
        android:textSize="12sp"
        android:textColor="@color/accent"
        android:layout_gravity="top|end"
        android:id="@+id/osmSwitch"
        android:background="@drawable/bg_key"
        android:paddingTop="9dp"
        android:paddingBottom="9dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="78dp"
        android:text="@string/switch_to_ml"
        android:textAllCaps="false"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:layout_marginEnd="12dp" />
    <Button
        android:textSize="12sp"
        android:textColor="@color/accent"
        android:layout_gravity="top|end"
        android:id="@+id/osmSatellite"
        android:background="@drawable/bg_key"
        android:paddingTop="9dp"
        android:paddingBottom="9dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="132dp"
        android:text="@string/map_satellite"
        android:textAllCaps="false"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:layout_marginEnd="12dp" />
    <TextView
        android:textSize="20sp"
        android:textColor="@color/primary"
        android:gravity="center"
        android:layout_gravity="bottom|end"
        android:id="@+id/osmLocate"
        android:background="@drawable/bg_locate"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginBottom="170dp"
        android:text="◎"
        android:layout_marginEnd="14dp" />
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@color/bg"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/accent"
            android:gravity="center"
            android:id="@+id/osmCoords"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pos_no_point"
            android:textDirection="ltr" />
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">
            <Button
                android:textSize="15sp"
                android:textColor="@color/text"
                android:id="@+id/osmCancel"
                android:background="@drawable/bg_key"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:text="@string/cancel"
                android:layout_weight="1"
                android:textAllCaps="false"
                android:layout_marginEnd="8dp" />
            <Button
                android:enabled="false"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#04140E"
                android:id="@+id/osmConfirm"
                android:background="@drawable/bg_primary_button"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:text="@string/confirm_pick"
                android:layout_weight="1"
                android:textAllCaps="false" />
        </LinearLayout>
        <TextView
            android:textSize="10sp"
            android:textColor="@color/text_muted"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/osm_attribution" />
    </LinearLayout>
</FrameLayout>
